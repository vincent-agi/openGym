{
  "$schema": "https://json.schemastore.org/tsconfig",
  "// about": "Shared TypeScript options for api/ and frontend/. Change strictness here, once. See docs/adr/0001-migrate-to-typescript.md.",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    "allowJs": true,
    "checkJs": false
  }
}
